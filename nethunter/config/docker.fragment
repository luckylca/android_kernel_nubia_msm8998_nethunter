# NX563J NetHunter Docker test fragment.
#
# Ported from the Docker-capable downstream Ubuntu kernel configuration that
# was validated end-to-end on this device on 2026-09-19. Keep CFS_BANDWIDTH
# disabled: this CAF 4.4 tree has incomplete bandwidth code and enabling it
# breaks the build. Docker --cpu-shares works through FAIR_GROUP_SCHED.
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_MEMCG_KMEM=y
CONFIG_VETH=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_CT_NETLINK=y
